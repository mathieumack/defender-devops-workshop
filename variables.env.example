# ===========================================================================
# variables.env.example — Template for required environment variables
# ===========================================================================
# Copy this file to variables.env and fill in your values:
#   cp variables.env.example variables.env
#
# NEVER commit variables.env to source control (it's in .gitignore).
# ===========================================================================

# ── Azure Configuration ────────────────────────────────────────────────────
# Your Azure subscription ID
SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"

# Your Azure AD tenant ID
TENANT_ID="00000000-0000-0000-0000-000000000000"

# Azure region for all resources
LOCATION="eastus"

# Name for the demo resource group
RESOURCE_GROUP="rg-defender-devops-demo"

# ── Container Registry ─────────────────────────────────────────────────────
# Globally unique name (3-50 alphanumeric, lowercase)
ACR_NAME="acrdefdevopsdemo"

# ── Application ────────────────────────────────────────────────────────────
# Container App name
APP_NAME="demo-api"

# ── Repository ─────────────────────────────────────────────────────────────
# GitHub or Azure DevOps repo name (for reference in scripts)
REPO_NAME="defender-devops-workshop"
