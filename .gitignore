# Defender for DevOps Demo — Git Ignore
# =======================================

# Environment variables (never commit real values)
variables.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# Build outputs
*.sarif

# Bicep compiled ARM templates (generated by az bicep build)
infra/main.json
iac-misconfig/*.json
