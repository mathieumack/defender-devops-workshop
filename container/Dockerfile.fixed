# ---------------------------------------------------------------------------
# container/Dockerfile.fixed — Remediated Container Image
# ---------------------------------------------------------------------------
# All issues from the vulnerable Dockerfile are resolved:
#
#   1. Uses a current, patched base image (python:3.12-slim).
#   2. Runs as a non-root user.
#   3. Installs fixed dependency versions.
#   4. No secrets baked into image layers.
# ---------------------------------------------------------------------------

# FIX 1: Current base image with latest security patches
FROM python:3.12-slim

WORKDIR /app

# FIX 3: Use patched dependencies
COPY app/requirements-fixed.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# FIX 2: Create and switch to non-root user
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser
COPY app/server-fixed.py server.py
RUN chown -R appuser:appuser /app
USER appuser

# FIX 4: No secrets in image — pass via runtime environment
# ENV AZURE_STORAGE_KEY is NOT set here

EXPOSE 5000

CMD ["python", "server.py"]
